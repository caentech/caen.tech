---
// Gabarit commun aux variantes d'intégration des photos sur l'accueil
// (pages /variantes/N). Il reprend la page d'accueil telle quelle, sauf la zone
// hero + photos fournie par chaque variante via le slot par défaut, et ajoute
// un sélecteur flottant pour passer d'une variante à l'autre.
import BaseLayout from "./BaseLayout.astro";
import WhyAttend from "../components/WhyAttend.astro";
import ProgramTeaser from "../components/ProgramTeaser.astro";
import SpeakersTeaser from "../components/SpeakersTeaser.astro";
import VenuePreview from "../components/VenuePreview.astro";
import SponsorsTeaser from "../components/SponsorsTeaser.astro";
import CtaFinal from "../components/CtaFinal.astro";
import SponsoringCall from "../components/SponsoringCall.astro";

interface Props {
  current: number;
  name: string;
  // La variante éditoriale remplace « Pourquoi venir ? » par sa propre version illustrée
  replacesWhyAttend?: boolean;
}

const { current, name, replacesWhyAttend = false } = Astro.props;

const variants = [
  "Panneaux",
  "Plein cadre",
  "Mosaïque",
  "Éditorial",
  "Polaroïds",
];
---

<BaseLayout title={`Variante ${current} — ${name} | Caen.Tech`}>
  <SponsoringCall />
  <slot />
  {!replacesWhyAttend && <WhyAttend />}
  <ProgramTeaser />
  <SpeakersTeaser />
  <VenuePreview />
  <SponsorsTeaser />
  <CtaFinal />

  <nav class="VariantSwitcher" aria-label="Variantes de la page d'accueil">
    <a class="VariantSwitcher-link" href="/">Actuelle</a>
    {variants.map((label, i) => (
      <a
        class:list={["VariantSwitcher-link", { current: i + 1 === current }]}
        href={`/variantes/${i + 1}`}
        aria-current={i + 1 === current ? "page" : undefined}
      >
        {i + 1}. {label}
      </a>
    ))}
  </nav>
</BaseLayout>

<style>
  .VariantSwitcher {
    position: fixed;
    bottom: var(--space-md);
    left: 50%;
    z-index: 100;
    display: flex;
    gap: var(--space-xs);
    max-width: calc(100vw - 2 * var(--space-md));
    padding: var(--space-xs);
    overflow-x: auto;
    scrollbar-width: none;
    transform: translateX(-50%);
    background: var(--color-bg-dark);
    border-radius: 999px;
    box-shadow: var(--shadow-lg);
  }

  .VariantSwitcher-link {
    flex: none;
    padding: var(--space-xs) var(--space-md);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-on-dark);
    text-decoration: none;
    border-radius: 999px;
  }

  .VariantSwitcher-link:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .VariantSwitcher-link.current {
    background: var(--color-primary);
    color: var(--color-text);
  }
</style>

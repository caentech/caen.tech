---
// Variante 4 — Éditorial (inspirée du DevFest Lille) : le hero reste tel quel,
// et « Pourquoi venir ? » devient une suite de blocs photo + texte alternés,
// chaque argument illustré par une photo de l'édition précédente.
import HomeVariantLayout from "../../layouts/HomeVariantLayout.astro";
import { MapPin, Calendar } from "lucide-astro";
import { getEntry } from "astro:content";

const site = (await getEntry("site", "caen-tech-2026"))!.data;

const reasons = [
  {
    n: 29,
    alt: "Un intervenant présente sa conférence",
    title: "Des retours concrets",
    text: "Pas des pitchs corporate — des retours d'expérience terrain, par des gens qui font la tech au quotidien.",
  },
  {
    n: 25,
    alt: "Les échanges entre participant·es pendant une pause",
    title: "Une communauté locale, accessible",
    text: "Un événement à taille humaine, où l'on se croise, on discute, on avance ensemble.",
  },
  {
    n: 16,
    alt: "Une table ronde sur scène",
    title: "Tech, produit, data, design, infra, entrepreneuriat",
    text: "Un programme pluridisciplinaire qui reflète la réalité de nos métiers.",
  },
  {
    n: 34,
    alt: "Des bénévoles à l'œuvre en coulisses",
    title: "Des gens qui construisent, ici",
    text: "On met en avant ceux qui bâtissent l'écosystème tech caennais et normand.",
  },
];
---

<HomeVariantLayout current={4} name="Éditorial" replacesWhyAttend>
  <section class="Hero">
    <div class="Hero-wrap Wrap">
      <img class="Hero-logo" src="/images/logo-bar-white.svg" alt="Caen.Tech" width="280" height="80" />
      <h1 class="Hero-title">Une journée pour ceux qui font la Tech à Caen</h1>
      <p class="Hero-subtitle">Conférences, retours d'expérience et rencontres</p>
      <div class="Hero-meta">
        <span class="Hero-metaItem"><MapPin size={18} /> {site.venue.name}</span>
        <span class="Hero-metaItem"><Calendar size={18} /> 09/06/2026</span>
      </div>
      <div class="Hero-actions">
        <a href="https://www.youtube.com/@CaenTech" class="Btn dark" target="_blank" rel="noopener">
          Accéder aux replays
        </a>
        <a href="/programme/2026" class="Btn outline">Voir le programme</a>
      </div>
    </div>
  </section>

  <section class="Section">
    <div class="Wrap">
      <h2 class="Section-title">Pourquoi venir ?</h2>
      <div class="Editorial">
        {reasons.map(({ n, alt, title, text }) => (
          <article class="Editorial-item">
            <a class="Editorial-photo" href={`/photos#photo-${n}`}>
              <img src={`/images/photos/photo-${n}.webp`} alt={alt} width="1600" height="1067" />
            </a>
            <div class="Editorial-text">
              <h3 class="Editorial-title">{title}</h3>
              <p>{text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</HomeVariantLayout>

<style>
  .Editorial {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .Editorial-item {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .Editorial-photo {
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .Editorial-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .Editorial-photo:hover img {
    transform: scale(1.04);
  }

  /* Filet pointillé jaune devant chaque titre, en clin d'œil au DevFest Lille */
  .Editorial-text {
    padding-left: var(--space-lg);
    border-left: 4px dotted var(--color-primary-dark);
  }

  .Editorial-title {
    font-size: var(--text-2xl);
    line-height: 1.2;
    margin-bottom: var(--space-sm);
  }

  .Editorial-text p {
    font-size: var(--text-lg);
    color: var(--color-text-light);
  }

  @media (min-width: 768px) {
    .Editorial-item {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }

    .Editorial-item:nth-child(even) .Editorial-photo {
      order: 2;
    }
  }
</style>

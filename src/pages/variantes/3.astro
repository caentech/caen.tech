---
// Variante 3 — Mosaïque : le hero jaune passe en deux colonnes, le texte à
// gauche et une mosaïque de cinq photos à droite, chacune menant à la galerie.
import HomeVariantLayout from "../../layouts/HomeVariantLayout.astro";
import { MapPin, Calendar } from "lucide-astro";
import { getEntry } from "astro:content";

const site = (await getEntry("site", "caen-tech-2026"))!.data;

const tiles = [
  { n: 48, alt: "Le public installé dans la salle" },
  { n: 36, alt: "Deux bénévoles en t-shirt Caen.Tech" },
  { n: 16, alt: "Une table ronde sur scène" },
  { n: 53, alt: "Deux participants discutent pendant une pause" },
  { n: 29, alt: "Un intervenant présente sa conférence" },
];
---

<HomeVariantLayout current={3} name="Mosaïque">
  <section class="Hero Mosaic">
    <div class="Mosaic-wrap Wrap">
      <div class="Mosaic-text">
        <img class="Hero-logo" src="/images/logo-bar-white.svg" alt="Caen.Tech" width="280" height="80" />
        <h1 class="Hero-title">Une journée pour ceux qui font la Tech à Caen</h1>
        <p class="Hero-subtitle">Conférences, retours d'expérience et rencontres</p>
        <div class="Hero-meta Mosaic-start">
          <span class="Hero-metaItem"><MapPin size={18} /> {site.venue.name}</span>
          <span class="Hero-metaItem"><Calendar size={18} /> 09/06/2026</span>
        </div>
        <div class="Hero-actions Mosaic-start">
          <a href="https://www.youtube.com/@CaenTech" class="Btn dark" target="_blank" rel="noopener">
            Accéder aux replays
          </a>
          <a href="/programme/2026" class="Btn outline">Voir le programme</a>
        </div>
      </div>
      <div class="Mosaic-grid">
        {tiles.map(({ n, alt }) => (
          <a class="Mosaic-tile" href={`/photos#photo-${n}`}>
            <img src={`/images/photos/photo-${n}.webp`} alt={alt} width="1600" height="1067" />
          </a>
        ))}
      </div>
    </div>
  </section>
</HomeVariantLayout>

<style>
  .Mosaic {
    text-align: left;
    padding-block: var(--space-xl);
  }

  .Mosaic-wrap {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .Mosaic-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
  }

  .Mosaic .Hero-logo {
    max-width: 180px;
  }

  .Mosaic-start {
    justify-content: flex-start;
  }

  .Mosaic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 8rem);
    gap: var(--space-sm);
  }

  /* Grande photo à gauche sur deux rangs, puis quatre vignettes autour */
  .Mosaic-tile:nth-child(1) { grid-area: 1 / 1 / 3 / 3; }
  .Mosaic-tile:nth-child(2) { grid-area: 1 / 3 / 2 / 4; }
  .Mosaic-tile:nth-child(3) { grid-area: 2 / 3 / 4 / 4; }
  .Mosaic-tile:nth-child(4) { grid-area: 3 / 1 / 4 / 2; }
  .Mosaic-tile:nth-child(5) { grid-area: 3 / 2 / 4 / 3; }

  .Mosaic-tile {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .Mosaic-tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .Mosaic-tile:hover img {
    transform: scale(1.05);
  }

  @media (min-width: 1024px) {
    .Mosaic-wrap {
      grid-template-columns: 5fr 6fr;
    }

    .Mosaic-grid {
      grid-template-rows: repeat(3, 10rem);
    }
  }
</style>

---
// Variante 5 — Polaroïds : le hero jaune centré reste, mais des tirages photo
// légendés et inclinés sont éparpillés de part et d'autre du texte, comme
// épinglés sur un tableau de liège. Sur mobile, ils passent en rangée défilable.
import HomeVariantLayout from "../../layouts/HomeVariantLayout.astro";
import { MapPin, Calendar } from "lucide-astro";
import { getEntry } from "astro:content";

const site = (await getEntry("site", "caen-tech-2026"))!.data;

// Position et inclinaison de chaque tirage sont posées en CSS (nth-child)
const prints = [
  { n: 2, caption: "L'accueil", alt: "L'accueil des participant·es par les bénévoles Caen.Tech" },
  { n: 48, caption: "Salle comble", alt: "Le public installé dans la salle" },
  { n: 44, caption: "Sur scène", alt: "Un intervenant sur scène" },
  { n: 36, caption: "Les bénévoles", alt: "Deux bénévoles en t-shirt Caen.Tech" },
  { n: 53, caption: "Les pauses", alt: "Deux participants discutent pendant une pause" },
  { n: 16, caption: "Table ronde", alt: "Une table ronde sur scène" },
];
---

<HomeVariantLayout current={5} name="Polaroïds">
  <section class="Hero Prints">
    <div class="Hero-wrap Wrap">
      <img class="Hero-logo" src="/images/logo-bar-white.svg" alt="Caen.Tech" width="280" height="80" />
      <h1 class="Hero-title">Une journée pour ceux qui font la Tech à Caen</h1>
      <p class="Hero-subtitle">Conférences, retours d'expérience et rencontres</p>
      <div class="Hero-meta">
        <span class="Hero-metaItem"><MapPin size={18} /> {site.venue.name}</span>
        <span class="Hero-metaItem"><Calendar size={18} /> 09/06/2026</span>
      </div>
      <div class="Hero-actions">
        <a href="https://www.youtube.com/@CaenTech" class="Btn dark" target="_blank" rel="noopener">
          Accéder aux replays
        </a>
        <a href="/programme/2026" class="Btn outline">Voir le programme</a>
      </div>
    </div>
    <div class="Prints-board">
      {prints.map(({ n, caption, alt }) => (
        <a class="Prints-item" href={`/photos#photo-${n}`}>
          <img class="Prints-image" src={`/images/photos/photo-${n}.webp`} alt={alt} width="1600" height="1067" />
          <span class="Prints-caption">{caption}</span>
        </a>
      ))}
    </div>
  </section>
</HomeVariantLayout>

<style>
  .Prints-board {
    position: relative;
    z-index: 1;
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    padding: var(--space-md);
    overflow-x: auto;
  }

  .Prints-item {
    flex: none;
    display: block;
    width: 13rem;
    padding: 0.6rem 0.6rem 0;
    background: #fff;
    color: var(--color-text);
    text-decoration: none;
    box-shadow: var(--shadow-lg);
    transform: rotate(var(--tilt, 0deg));
    transition: transform var(--transition);
  }

  .Prints-item:hover {
    transform: rotate(0deg) scale(1.08);
    z-index: 2;
  }

  .Prints-image {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .Prints-caption {
    display: block;
    padding-block: var(--space-sm);
    font-weight: 600;
    font-size: var(--text-sm);
    text-align: center;
  }

  .Prints-item:nth-child(1) { --tilt: -6deg; }
  .Prints-item:nth-child(2) { --tilt: 4deg; }
  .Prints-item:nth-child(3) { --tilt: -3deg; }
  .Prints-item:nth-child(4) { --tilt: 5deg; }
  .Prints-item:nth-child(5) { --tilt: -4deg; }
  .Prints-item:nth-child(6) { --tilt: 3deg; }

  /* Sur grand écran, les tirages quittent la rangée et s'éparpillent de part
     et d'autre du texte, trois à gauche, trois à droite. */
  @media (min-width: 1200px) {
    .Prints {
      padding-block: var(--space-2xl) calc(var(--space-2xl) + var(--space-lg));
    }

    .Prints-board {
      position: absolute;
      inset: 0;
      margin: 0;
      padding: 0;
      overflow: visible;
      pointer-events: none;
    }

    .Prints-item {
      position: absolute;
      width: 12rem;
      pointer-events: auto;
    }

    .Prints-item:nth-child(1) { top: 8%; left: 4%; --tilt: -8deg; }
    .Prints-item:nth-child(2) { top: 40%; left: 11%; --tilt: 5deg; }
    .Prints-item:nth-child(3) { top: 66%; left: 2%; --tilt: -3deg; }
    .Prints-item:nth-child(4) { top: 6%; right: 5%; --tilt: 7deg; }
    .Prints-item:nth-child(5) { top: 36%; right: 12%; --tilt: -5deg; }
    .Prints-item:nth-child(6) { top: 64%; right: 3%; --tilt: 4deg; }
  }

  @media (prefers-reduced-motion: reduce) {
    .Prints-item {
      transition: none;
    }
  }
</style>

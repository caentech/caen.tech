---
// Variante 1 — Panneaux (inspirée du DevFest Strasbourg) : le hero devient un
// grand panneau photo portant le texte, flanqué de deux panneaux étroits
// légendés. Au survol, le panneau visé s'élargit.
import HomeVariantLayout from "../../layouts/HomeVariantLayout.astro";
import { MapPin, Calendar } from "lucide-astro";
import { getEntry } from "astro:content";

const site = (await getEntry("site", "caen-tech-2026"))!.data;

const sidePanels = [
  { n: 16, label: "Tables rondes", alt: "Une table ronde sur scène" },
  { n: 25, label: "Rencontres", alt: "Les échanges entre participant·es pendant une pause" },
];
---

<HomeVariantLayout current={1} name="Panneaux">
  <section class="Panels">
    <div class="Panels-row">
      <div class="Panels-main">
        <img
          class="Panels-image"
          src="/images/photos/photo-6.webp"
          alt=""
          width="1600"
          height="1067"
          fetchpriority="high"
        />
        <div class="Panels-content">
          <p class="Panels-kicker">
            <span><Calendar size={18} /> 09/06/2026</span>
            <span><MapPin size={18} /> {site.venue.name}</span>
          </p>
          <h1 class="Panels-title">Une journée pour ceux qui font la Tech à Caen</h1>
          <p class="Panels-subtitle">Conférences, retours d'expérience et rencontres</p>
          <div class="Panels-actions">
            <a href="https://www.youtube.com/@CaenTech" class="Btn primary" target="_blank" rel="noopener">
              Accéder aux replays
            </a>
            <a href="/programme/2026" class="Btn Panels-ghost">Voir le programme</a>
          </div>
        </div>
      </div>
      {sidePanels.map(({ n, label, alt }) => (
        <a class="Panels-side" href={`/photos#photo-${n}`}>
          <img class="Panels-image" src={`/images/photos/photo-${n}.webp`} alt={alt} width="1600" height="1067" />
          <span class="Panels-label">{label}</span>
        </a>
      ))}
    </div>
  </section>
</HomeVariantLayout>

<style>
  .Panels {
    padding: var(--space-md);
    background: var(--color-primary);
  }

  .Panels-row {
    display: flex;
    gap: var(--space-md);
    height: min(80vh, 640px);
  }

  .Panels-main,
  .Panels-side {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    transition: flex-grow 0.5s ease;
  }

  .Panels-main {
    flex: 5 1 0;
  }

  .Panels-side {
    flex: 1.2 1 0;
    color: #fff;
    text-decoration: none;
  }

  .Panels-row:has(.Panels-side:hover) .Panels-main {
    flex-grow: 3.5;
  }

  .Panels-side:hover {
    flex-grow: 2.5;
  }

  .Panels-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .Panels-main::after,
  .Panels-side::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0.1) 70%);
  }

  .Panels-main::after {
    background: linear-gradient(to right, rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.15) 75%);
  }

  .Panels-content {
    position: absolute;
    z-index: 1;
    inset: auto var(--space-lg) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 36rem;
    color: #fff;
  }

  .Panels-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-weight: 700;
    color: var(--color-primary);
  }

  .Panels-kicker span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .Panels-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: 1.1;
  }

  .Panels-subtitle {
    font-size: var(--text-lg);
    opacity: 0.9;
  }

  .Panels-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .Panels-ghost {
    color: #fff;
    border-color: #fff;
  }

  .Panels-ghost:hover {
    background: #fff;
    color: var(--color-text);
  }

  .Panels-label {
    position: absolute;
    z-index: 1;
    left: var(--space-md);
    bottom: var(--space-lg);
    font-size: var(--text-lg);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .Panels-row {
      flex-wrap: wrap;
      height: auto;
    }

    .Panels-main {
      flex-basis: 100%;
      min-height: 32rem;
    }

    .Panels-side {
      height: 9rem;
    }

    .Panels-content {
      inset: auto var(--space-md) var(--space-md);
    }

    .Panels-main::after {
      background: linear-gradient(to top, rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0.2));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .Panels-main,
    .Panels-side {
      transition: none;
    }
  }
</style>
